{
  "entities": {
    "shops": {
      "title": "Shop",
      "description": "Multiplan Center shop records",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shop_number": { "type": "string" },
        "floor": { "type": "string" },
        "floor_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "floor": { "type": "string" },
              "shop_number": { "type": "string" }
            }
          }
        },
        "phone": { "type": "string" },
        "logo": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" }
      },
      "required": ["name", "floor", "shop_number"]
    },
    "transactions": {
      "title": "ShopTransaction",
      "description": "User purchase or sale transactions with a shop, supporting multiple line items",
      "type": "object",
      "properties": {
        "shop_id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["Purchase", "Sale"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit_price": { "type": "number" },
              "total_price": { "type": "number" }
            },
            "required": ["product_name", "quantity", "unit_price", "total_price"]
          }
        },
        "product_name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit_price": { "type": "number" },
        "total_amount": { "type": "number" },
        "notes": { "type": "string" },
        "created_at": { "type": "number" }
      },
      "required": ["shop_id", "user_id", "date", "type", "total_amount"]
    },
    "user_access": {
      "title": "UserAccess",
      "description": "Whitelisted and permitted user Gmail accounts for accessing the directory",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "banned"] },
        "can_edit": { "type": "boolean" },
        "request_note": { "type": "string" },
        "requested_at": { "type": "number" },
        "updated_at": { "type": "number" },
        "approved_by": { "type": "string" },
        "edit_permitted_at": { "type": "number" }
      },
      "required": ["email", "status"]
    }
  }
}
